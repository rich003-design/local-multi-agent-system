{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug Multi-Agent CLI",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/coordinator.py",
        "cwd": "${workspaceFolder}",
        "envFile": "${workspaceFolder}/.env",
        "console": "integratedTerminal",
        "justMyCode": true
      },
      {
        "name": "Debug Multi-Agent Streamlit",
        "type": "debugpy",
        "request": "launch",
        "module": "streamlit",
        "args": [
          "run",
          "${workspaceFolder}/app.py"
        ],
        "cwd": "${workspaceFolder}",
        "envFile": "${workspaceFolder}/.env",
        "console": "integratedTerminal",
        "justMyCode": true
      }
    ]
  }
  